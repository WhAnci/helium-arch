#!/usr/bin/env bash
# Test double for gpg: import/list always succeed, verification is controlled
# by FAKE_PGP_FAIL.
set -euo pipefail

verify=0
for arg in "$@"; do
  [[ "$arg" == "--verify" ]] && verify=1
done

if (( verify == 1 )) && [[ "${FAKE_PGP_FAIL:-0}" == "1" ]]; then
  echo 'gpg: Signature made Thu Jan  1 00:00:00 2026 UTC' >&2
  echo 'gpg:                using RSA key 0000000000000000000000000000000000000000' >&2
  echo 'gpg: BAD signature from "Fake Helium Signing Key"' >&2
  exit 1
fi

exit 0
