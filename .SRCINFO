	depends = ttf-liberation
	depends = xdg-utils
	optdepends = apparmor: load the shipped AppArmor profile
	optdepends = desktop-file-utils: refresh the desktop MIME database via the pacman hook
	optdepends = gnome-keyring: Secret Service password storage on GNOME
	optdepends = kdialog: native KDE dialogs
	optdepends = kwallet: password storage on KDE Plasma
	optdepends = pciutils: GPU diagnostics (lspci)
	optdepends = pipewire: WebRTC desktop sharing and screen capture on Wayland
	optdepends = qt5-base: Qt 5 theme integration (bundled Qt shim)
	optdepends = qt6-base: Qt 6 theme integration (bundled Qt shim)
	optdepends = upower: Battery Status API support
	optdepends = xdg-desktop-portal: native file chooser and screen sharing on Wayland
